# ==========================================
# 1. 板型配置 (强制指定为 Otto 机器人)
# ==========================================
CONFIG_BOARD_TYPE_OTTO_ROBOT=y
# CONFIG_BOARD_TYPE_BREAD_COMPACT_WIFI is not set

# ==========================================
# 2. PSRAM 配置 (ESP32-S3-N16R8 必须开启 Octal PSRAM)
# ==========================================
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ==========================================
# 3. WebSocket 服务 (配合 websocket_control_server.cc)
# ==========================================
CONFIG_HTTPD_WS_SUPPORT=y

# ==========================================
# 4. 自定义唤醒词配置 (拼音格式识别率最高)
# ==========================================
CONFIG_USE_CUSTOM_WAKE_WORD=y
CONFIG_CUSTOM_WAKE_WORD="ni hao xiao zhi"
CONFIG_SR_MN_CN_MULTINET7_QUANT=y

# ==========================================
# 5. Flash 容量与 16MB 自定义分区表
# ==========================================
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions/v2/16m.csv"

# ==========================================
# 6. 强制打包本地资源 (保证屏幕字体、表情、唤醒词模型被打包进 assets.bin)
# ==========================================
CONFIG_FLASH_DEFAULT_ASSETS=y
CONFIG_USE_DEFAULT_ASSETS=y
