# ==========================================
# ESP32-S3 专属最终强制覆盖配置 (最高优先级)
# ==========================================

# 1. 强制锁定板型为 Otto Robot
CONFIG_BOARD_TYPE_OTTO_ROBOT=y
# CONFIG_BOARD_TYPE_BREAD_COMPACT_WIFI is not set

# 2. 强制锁定 16MB Flash 与 16m 分区表
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions/v2/16m.csv"

# 3. 强制打包中文字库和完整表情资源 (解决屏幕无字问题)
CONFIG_FLASH_DEFAULT_ASSETS=y
CONFIG_USE_DEFAULT_ASSETS=y

# 4. 【核心修复】启用自定义唤醒词 (MultiNet)
# 关闭默认的 AFE/WakeNet 唤醒，避免冲突
# CONFIG_USE_AFE_WAKE_WORD is not set
# CONFIG_USE_WAKENET is not set
# 开启自定义唤醒词支持
CONFIG_USE_CUSTOM_WAKE_WORD=y
# 设置自定义唤醒词拼音，例如“你好小智”就是 ni hao xiao zhi
CONFIG_CUSTOM_WAKE_WORD="ni hao xiao zhi"
# 设置唤醒词在屏幕上的显示文本
CONFIG_CUSTOM_WAKE_WORD_DISPLAY="你好小智"
# 启用中文 MultiNet7 量化模型
CONFIG_SR_MN_CN_MULTINET7_QUANT=y
# 启用中文 MultiNet6 量化模型 (可选，作为备选)
CONFIG_SR_MN_CN_MULTINET6_QUANT=y

# 5. 确保 WebSocket 开启
CONFIG_HTTPD_WS_SUPPORT=y
