CONFIG_BOARD_TYPE_OTTO_ROBOT=y
# CONFIG_BOARD_TYPE_BREAD_COMPACT_WIFI is not set
CONFIG_HTTPD_WS_SUPPORT=y

# 16MB Flash 与自定义分区表
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions/v2/16m.csv"

# 强制打包完整资源与语言
CONFIG_FLASH_DEFAULT_ASSETS=y
CONFIG_USE_DEFAULT_ASSETS=y
CONFIG_LANGUAGE_ZH_CN=y

# 【核心修复】强制开启 8MB PSRAM 并接管内存，防止 LVGL 塞爆内部 DRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# LVGL 强制使用系统 malloc (走 PSRAM)
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEM_CUSTOM_INCLUDE="stdlib.h"

# 【自定义唤醒词配置】
CONFIG_USE_AFE_WAKE_WORD=y
CONFIG_USE_WAKENET=y
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y
CONFIG_USE_CUSTOM_WAKE_WORD=y
CONFIG_CUSTOM_WAKE_WORD="ka ka"
CONFIG_CUSTOM_WAKE_WORD_DISPLAY="卡卡"
CONFIG_SR_MN_CN_MULTINET7_QUANT=y

# 【防崩修复】关闭看门狗，防止底层死循环重启
CONFIG_ESP_TASK_WDT_EN=n
