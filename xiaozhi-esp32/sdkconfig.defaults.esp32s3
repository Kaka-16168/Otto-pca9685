CONFIG_BOARD_TYPE_OTTO_ROBOT=y
# CONFIG_BOARD_TYPE_BREAD_COMPACT_WIFI is not set
CONFIG_HTTPD_WS_SUPPORT=y

# 16MB Flash 与自定义分区表
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions/v2/16m.csv"

# ==========================================
# 【唤醒词与资源】强制打包
# ==========================================
CONFIG_FLASH_DEFAULT_ASSETS=y
CONFIG_USE_DEFAULT_ASSETS=y

CONFIG_USE_AFE_WAKE_WORD=n
CONFIG_USE_WAKENET=n
CONFIG_SR_WN_WN9_HIESP=n
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n

CONFIG_USE_CUSTOM_WAKE_WORD=y
CONFIG_CUSTOM_WAKE_WORD="ka ka"
CONFIG_CUSTOM_WAKE_WORD_DISPLAY="卡卡"
CONFIG_SR_MN_CN_MULTINET7_QUANT=y

# 内存与 PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y
